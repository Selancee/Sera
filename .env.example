# Sera V0.2 environment example.
# Copy to .env locally if needed. Do not commit real API keys.

SERA_LLM_PROVIDER=mock
SERA_LLM_MODEL=gpt-4.1-mini
SERA_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional neural symbolic model inference. The launcher also sets this default
# for backend processes. Keep model.pt outside Git under this ignored folder.
SERA_SYMBOLIC_MODEL_DIR=D:\Sera\models\sera_symbolic_small
SERA_SYMBOLIC_MODEL_CHECKPOINT=

# Use "model" to try the trained symbolic backend first and fall back to
# rule_based output until constrained MusicXML decoding is complete.
SERA_GENERATOR_BACKEND=model
