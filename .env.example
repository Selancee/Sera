# Sera editing-layer environment example.
# Copy to .env locally if needed. Do not commit real API keys.

# Interactive Agent provider. Keep local_rule for an API-key-free offline mode.
# For OpenAI, set provider=openai and configure the key in OPENAI_API_KEY or
# SERA_LLM_API_KEY. Packaged Sera also reads %LOCALAPPDATA%\Sera\llm.env.
SERA_LLM_PROVIDER=local_rule
SERA_LLM_MODEL=gpt-5.6-terra
SERA_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
SERA_LLM_API_KEY=
SERA_LLM_API_KEY_ENV=
SERA_LLM_TIMEOUT_SECONDS=90
SERA_LLM_MAX_OUTPUT_TOKENS=4000
# Composer returns a local draft first; these bound only the background high-level plan.
SERA_COMPOSER_LLM_TIMEOUT_SECONDS=180
SERA_COMPOSER_LLM_MAX_OUTPUT_TOKENS=2048
SERA_LLM_REASONING_EFFORT=low
SERA_LLM_STORE=false
SERA_LLM_FALLBACK_LOCAL=true
SERA_LLM_STRUCTURED_OUTPUTS=true
SERA_LLM_INPUT_COST_PER_MILLION=
SERA_LLM_OUTPUT_COST_PER_MILLION=

VITE_API_BASE_URL=http://127.0.0.1:8000

# Whole-score generation/model pages are legacy compatibility surfaces and are
# hidden by default. Set true only when maintaining the older generation path.
VITE_SERA_ENABLE_LEGACY_GENERATION=false

# The benchmark audit workspace is publication/research tooling, not part of the
# ordinary Agent workflow. Enable it only for a dedicated research-review build.
VITE_SERA_ENABLE_RESEARCH_REVIEW=false

# Optional executable hints. V1 file exchange works without these paths; they
# are reserved for preview rendering and future QML/ManuScript host bridges.
MUSESCORE_PATH=
SIBELIUS_PATH=

# Optional neural symbolic model inference. The launcher also sets this default
# for backend processes. Keep model.pt outside Git under this ignored folder.
SERA_ACTIVE_SYMBOLIC_MODEL=sera_symbolic_small
SERA_SYMBOLIC_MODEL_DIR=D:\Sera\models\sera_symbolic_small
SERA_SYMBOLIC_MODEL_CHECKPOINT=

# Use "model" to try the trained symbolic backend first and fall back to
# a safe MusicXML assembler until constrained MusicXML decoding is complete.
SERA_GENERATOR_BACKEND=model
