# Sera V0.2 environment example.
# Copy to .env locally if needed. Do not commit real API keys.

SERA_LLM_PROVIDER=mock
SERA_LLM_MODEL=gpt-4.1-mini
SERA_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional neural symbolic model inference. If unset, the frontend Model Lab
# shows committed AutoDL sample evidence instead of live checkpoint inference.
SERA_SYMBOLIC_MODEL_DIR=
SERA_SYMBOLIC_MODEL_CHECKPOINT=
