# Frozen submission copies must retain exact bytes even with core.autocrlf=true.
paper/softwarex/baselines/**/files/** -text whitespace=-blank-at-eol
# The initial revision Markdown also retains the submitted hard line breaks.
paper/softwarex/revisions/**/manuscript/*.md -text whitespace=-blank-at-eol
# Publication evidence is hashed as bytes. Git must not rewrite line endings.
benchmark/** -text
experiments/softwarex_*/** -text
pyproject.toml -text
requirements*.txt -text
frontend/package-lock.json -text
